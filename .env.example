# Copy to .env (gitignored) and fill in — once per machine, not per branch.
# docker compose reads .env automatically; `make up` does the rest.
#
# These are the same values as steam-analytics' own .env, because that is the
# point: local Airflow runs the dev target as *you*, so a DAG run lands in
# exactly the schemas your direct `dbt build` writes. If you already have
# steam-analytics' .env filled in, copy it here and add the two paths at the
# bottom.

# Snowflake account identifier, e.g. FMBSGSW-YU41950 (from the account URL).
SNOWFLAKE_ACCOUNT=

# Your developer Snowflake user and its role. steam-infra's
# terraform/snowflake creates one user per entry in its `developers` list,
# named STEAM_DEV_<NAME>, with the DEVELOPER role: reads STEAM_RAW, writes
# STEAM_DEV, and nothing at all in STEAM_STAGING or STEAM_PROD.
SNOWFLAKE_USER=STEAM_DEV_YOURNAME
SNOWFLAKE_ROLE=DEVELOPER

# The database the dev target builds into. Every developer shares STEAM_DEV
# and is separated by SNOWFLAKE_SCHEMA below, not by database.
SNOWFLAKE_DATABASE=STEAM_DEV

# Your developer schema prefix — REQUIRED, and deliberately not defaulted.
# Every schema a run writes is <SNOWFLAKE_SCHEMA>_<layer>: dbt_yourname_stg,
# dbt_yourname_marts_core, ... Use the same value as steam-analytics' .env, or
# the DAG will write to a different sandbox than your direct dbt runs do.
SNOWFLAKE_SCHEMA=dbt_yourname

# Host path to your RSA private key (PEM, PKCS#8) — the half whose public key
# is registered on your Snowflake user. Mounted read-only into the container
# at /opt/airflow/secrets/snowflake_key.p8. Full path: nothing expands `~`
# here. If the key is encrypted, also set
# DBT_ENV_SECRET_SNOWFLAKE_KEY_PASSPHRASE.
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/you/.dbt/snowflake_key.p8

# Host path to your steam-analytics checkout. Mounted over the dbt project
# baked into the image, so your local model, macro and profiles.yml edits take
# effect on the next DAG parse with no rebuild. Run `dbt deps` in it once —
# Cosmos parses the mounted project, and the mount shadows the image's
# dbt_packages/.
STEAM_ANALYTICS_DIR=/Users/you/projects/steam-analytics

# Optional overrides.
# PIPELINE_ALERT_EMAIL=dev@localhost     # inert locally; must be non-empty
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# DBT_THREADS=4
# DBT_ENV_SECRET_SNOWFLAKE_KEY_PASSPHRASE=
# A specific image instead of :latest, e.g. to reproduce what staging runs.
# AIRFLOW_IMAGE_NAME=ghcr.io/dulain-willis/steam-orchestration:<sha>
